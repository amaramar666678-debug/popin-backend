generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String?
  username     String?  @unique
  country_code String   @default("US")
  bio          String?
  gender       String   @default("other")
  date_of_birth DateTime?
  latitude     Float?
  longitude    Float?
  looking_for  String?
  children_count Int?
  is_smoker    String?
  drinks_alcohol String?
  education_level String?
  work_status    String?
  relationship_status String?
  language     String   @default("en")
  is_verified  Boolean  @default(false)
  is_email_verified Boolean @default(false)
  email_verification_code String?
  email_verification_code_expires_at DateTime?
  is_location_hidden Boolean @default(false)
  is_profile_complete Boolean @default(false)
  is_visible_on_map Boolean @default(true)
  hearts       Int      @default(30)
   super_likes  Int      @default(1)
    message_credits Int   @default(2)
    eye_credits    Int   @default(2)
    rewind_credits Int   @default(0)
    next_eye_claim_at DateTime?
  heart_refill_at  DateTime?
  message_refill_at DateTime?
  eye_refill_at  DateTime?
  rewind_refill_at DateTime?
  last_ad_at   DateTime?
  last_seen_at DateTime?
  likes_seen_at DateTime?
  streak_count Int      @default(0)
  last_reward_claim_date DateTime?
  mystery_box_at DateTime?
  boost_expires_at DateTime?
  chat_color    String?
  chat_color_changed_at DateTime?
  is_banned     Boolean  @default(false)
  ban_reason    String?
  ban_expires_at DateTime?
  is_premium    Boolean  @default(false)
  subscription_tier String?
  subscription_expires_at DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  swipesSent   Swipe[]  @relation("swiper")
  swipesRecv   Swipe[]  @relation("target")
  matchesAs1   Match[]  @relation("user1")
  matchesAs2   Match[]  @relation("user2")
  messages     Message[]
  devices      Device[]
  images       Image[]
  blockedBy    BlockedUser[] @relation("blockedBy")
  blockedUsers BlockedUser[] @relation("blockedUser")
  reports      Report[]      @relation("reporter")
  reportedAs   Report[]      @relation("reported")
  notifications Notification[]
  profileViewsSent ProfileView[] @relation("ProfileViewViewer")
  profileViewsRecv ProfileView[] @relation("ProfileViewViewed")
  refreshTokens RefreshToken[]
  purchases   PurchaseLedger[]
}

// Immutable ledger of verified purchases. The unique purchaseToken is the
// idempotency guard that prevents double-granting (replay attacks).
model PurchaseLedger {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    String
  purchaseToken String  @unique
  orderId      String
  kind         String   @default("product") // "product" | "subscription"
  amount       Int      @default(0)
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy Int?
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Image {
  id         Int      @id @default(autoincrement())
  userId     Int
  imageUrl   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id        Int      @id @default(autoincrement())
  userId    Int
  fcmToken  String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fcmToken])
}

model Swipe {
  id        Int      @id @default(autoincrement())
  swiperId  Int
  targetId  Int
  action    String
  createdAt DateTime @default(now())

  swiper User @relation("swiper", fields: [swiperId], references: [id])
  target User @relation("target", fields: [targetId], references: [id])

  @@unique([swiperId, targetId])
}

model Match {
  id        Int      @id @default(autoincrement())
  user1Id   Int
  user2Id   Int
  matchedAt DateTime @default(now())

  user1        User           @relation("user1", fields: [user1Id], references: [id])
  user2        User           @relation("user2", fields: [user2Id], references: [id])
  conversation Conversation?
}

model Conversation {
  id        Int      @id @default(autoincrement())
  matchId   Int      @unique
  createdAt DateTime @default(now())
  is_muted  Boolean  @default(false)
  disappearing_messages Int? // null=off, 24=24h, 168=7d, 2160=90d (hours)
  is_direct_message Boolean @default(false) // true = opened from swipe "message" button (costs 1 credit on first message)
  initiated_by_user_id Int? // the user who started the direct message

  match    Match     @relation(fields: [matchId], references: [id])
  messages Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  type           String   @default("text") // text | system
  systemData     Json?    // { type: "color_change", color: "#FF0000" } etc.
  senderColor    String?
  sentAt         DateTime @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?
  isDeleted      Boolean  @default(false)
  reaction       String?
  voiceUrl       String?
  voiceDuration  Int?
  imageUrl       String?
  isSensitive    Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model BlockedUser {
  id           Int      @id @default(autoincrement())
  userId       Int
  blockedUserId Int
  createdAt    DateTime @default(now())

  user         User @relation("blockedBy", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser  User @relation("blockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId])
  @@index([blockedUserId])
}

model Report {
  id           Int      @id @default(autoincrement())
  reporterId   Int
  reportedUserId Int
  reason       String?
  createdAt    DateTime @default(now())

  reporter     User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // match | message | call | like | super_like
  title     String
  body      String
  relatedId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model VideoCallRequest {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  receiverId     Int
  status         String   @default("pending") // pending | approved | declined | expired
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model ProfileView {
  id         Int      @id @default(autoincrement())
  viewerId   Int
  viewedId   Int
  createdAt  DateTime @default(now())

  viewer     User     @relation("ProfileViewViewer", fields: [viewerId], references: [id])
  viewed     User     @relation("ProfileViewViewed", fields: [viewedId], references: [id])

  @@unique([viewerId, viewedId])
  @@index([viewedId])
  @@index([viewerId])
}
